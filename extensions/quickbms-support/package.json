{
  "name": "quickbms-support",
  "version": "0.2.6",
  "description": "QuickBMS extractor support",
  "scripts": {
    "build": "node build.mjs && pnpm extractInfo",
    "typecheck": "pnpm tsc",
    "test": "pnpm exec vitest run"
  },
  "author": "Black Tree Gaming Ltd.",
  "license": "GPL-3.0",
  "type": "commonjs",
  "private": true,
  "config": {
    "extensionName": "QuickBMS Support"
  },
  "devDependencies": {
    "@nexusmods/vortex-api": "workspace:*",
    "@types/bluebird": "catalog:",
    "@types/react": "catalog:",
    "@types/redux": "catalog:",
    "bluebird": "catalog:",
    "copyfiles": "catalog:",
    "cross-fetch": "catalog:",
    "i18next": "catalog:",
    "node-7z": "catalog:",
    "react": "catalog:",
    "react-i18next": "catalog:"
  },
  "nx": {
    "tags": [
      "vortex:extension"
    ],
    "targets": {
      "build": {
        "inputs": [
          "default",
          "typescript",
          "vortex-api",
          "{workspaceRoot}/scripts/build-archive-tools.mjs",
          "{workspaceRoot}/extensions/archiveToolLauncher.c"
        ]
      },
      "typecheck": {
        "inputs": [
          "default",
          "typescript",
          "vortex-api"
        ]
      }
    }
  }
}
