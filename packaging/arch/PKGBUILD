# CI stages the built application and replaces version/checksum placeholders.
pkgname=vortex
pkgver=2.9.1
pkgrel=1
epoch=1
pkgdesc='Nexus Mods Vortex mod manager (native Linux development build)'
arch=('x86_64')
url='https://github.com/vertigo-red/Vortex'
license=('GPL-3.0-only')
depends=(
  'alsa-lib'
  'at-spi2-core'
  'cairo'
  'dbus'
  'dotnet-runtime-9.0'
  'expat'
  'fontconfig'
  'glib2'
  'glibc'
  'gtk3'
  'libdrm'
  'libgcc'
  'libnotify'
  'libsecret'
  'libstdc++'
  'libx11'
  'libxcb'
  'libxcomposite'
  'libxdamage'
  'libxext'
  'libxfixes'
  'libxkbcommon'
  'libxrandr'
  'libxss'
  'mesa'
  'nspr'
  'nss'
  'pango'
  'xdg-utils'
)
optdepends=(
  'libappindicator-gtk3: system tray integration'
  'steam: discover and manage Steam/Proton games'
)
conflicts=('vortex-git' 'vortex-bin')
# Keep Electron, its sandbox helper and native addons intact.
options=('!strip' '!debug')
source=('vortex-app.tar.zst' 'vortex' 'vortex.desktop' 'vortex.png' 'LICENSE.md' 'BUILD-INFO.json')
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP')

package() {
  install -d "${pkgdir}/opt/vortex"
  cp -a "${srcdir}/linux-unpacked/." "${pkgdir}/opt/vortex/"
  chown -R root:root "${pkgdir}/opt/vortex"
  chmod 755 "${pkgdir}/opt/vortex/vortex"
  chmod 4755 "${pkgdir}/opt/vortex/chrome-sandbox"
  install -Dm755 "${srcdir}/vortex" "${pkgdir}/usr/bin/vortex"
  install -Dm644 "${srcdir}/vortex.desktop" "${pkgdir}/usr/share/applications/com.nexusmods.vortex.desktop"
  install -Dm644 "${srcdir}/vortex.png" "${pkgdir}/usr/share/icons/hicolor/256x256/apps/com.nexusmods.vortex.png"
  install -Dm644 "${srcdir}/LICENSE.md" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE.md"
  install -Dm644 "${srcdir}/BUILD-INFO.json" "${pkgdir}/usr/share/doc/${pkgname}/BUILD-INFO.json"
}
